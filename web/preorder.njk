---
title: Preorder
layout: layouts/base.njk
metaDesc: "Preorder Romina Garber's next book and get updates on release details and bonus information."
eleventyComputed:
  metaDesc: "{{ preorderPage.metaDescription }}"
---

<section class="newsletter">
  <div class="newsletter-intro">
    <h1>{{ preorderPage.heroTitle }}</h1>

    {{ preorderPage.intro | markdownify | safe }}
    
    <div class="medium-card-wrapper">
      <div class="card">
        <h3 class="data-label">
          {{ preorderPage.formCardTitle }}
        </h3>
        <p>
          <a class="btn btn--primary" href="{{ preorderPage.formUrl }}">{{ preorderPage.formButtonText }}</a>
        </p>
        <p>
          <small>{{ preorderPage.formDisclaimer }}</small>
        </p>
      </div>
    </div>
    <p>
      <strong>{{ preorderPage.campaignDeadlineLabel }}</strong> {{ preorderPage.campaignDeadline }}
    </p>  
    <div class="preorder-faq-section">
      <h2>{{ preorderPage.faqsTitle }}</h2>
      <ul class="faq">
        {% for faq in preorderPage.faqs %}
          <li><strong>{{ faq.question }}</strong><br> {{ faq.answer }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
